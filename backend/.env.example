DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=postgresql
DB_NAME=uniplace
DB_USER=uniplace
DB_PASSWORD=uniplace_dev_password
DB_HOST=127.0.0.1
DB_PORT=5432
COMPOSE_PROJECT_NAME=uniplace
# No Docker Desktop com arquivos no Windows, altere para true.
CHOKIDAR_USEPOLLING=false
CHOKIDAR_INTERVAL=300
